ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_BACKEND=agent_sdk
# agent_sdk takes Claude Code aliases (haiku | sonnet | opus); api takes full ids
LLM_MODEL=haiku
# For Docker with the Agent SDK: output of `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE_HOUSEHOLD=en-IN-NeerjaNeural
AZURE_TTS_VOICE_COOK=en-IN-NeerjaNeural
SPEECH_LANGUAGE=en-IN
# mock | mcp
INSTAMART_MODE=mock
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
DB_PATH=data/household.db
LOG_PATH=logs/events.jsonl
PLAN_WINDOW_DAYS=3
